# --- Required ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3000

# --- Linear (optional: leave blank to disable Linear tools) ---
# Create at https://linear.app/settings/api -> Personal API keys
LINEAR_API_KEY=lin_api_your-key-here

# --- Microsoft / Outlook OAuth (optional: leave blank to disable Outlook tools) ---
# 1. Go to https://portal.azure.com -> "App registrations" -> "New registration"
#    - Name: anything, e.g. "Nexus Assistant"
#    - Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#    - Redirect URI (type: Web): use the value you put in MICROSOFT_REDIRECT_URI below
# 2. Under "Certificates & secrets" -> "New client secret" -> copy the VALUE (not the ID) into MICROSOFT_CLIENT_SECRET
# 3. Under "API permissions" -> "Add a permission" -> Microsoft Graph -> Delegated permissions, add:
#    Mail.Send, Calendars.ReadWrite, offline_access, User.Read  (then "Grant admin consent" if you have an org account)
# 4. Copy the "Application (client) ID" into MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret-value
# Local dev:
# MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
# After deploying (e.g. to Render), use your live URL instead:
MICROSOFT_REDIRECT_URI=https://your-app-name.onrender.com/auth/microsoft/callback
